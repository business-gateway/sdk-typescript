{
  "name": "@businessgateway/sdk",
  "version": "0.1.0",
  "description": "TypeScript client for the Business Gateway Peppol API: send and receive documents, validate, read events, verify webhooks.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/business-gateway/sdk-typescript.git"
  },
  "homepage": "https://github.com/business-gateway/sdk-typescript#readme",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sync-spec": "cp ../docs/openapi.json spec/openapi.json && npm run generate",
    "generate": "openapi-typescript spec/openapi.json -o src/generated/openapi.ts"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "openapi-typescript": "7.13.0",
    "typescript": "^5.9.2",
    "vitest": "^5.0.0"
  }
}
